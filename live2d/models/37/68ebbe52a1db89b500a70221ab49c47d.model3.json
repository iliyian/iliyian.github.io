acy":{"Bonus":1000}}],"换装":[{"Name":"换装","Text":"选择时装","Choices":[{"Text":"初始","NextMtn":"换装:原皮"},{"Text":"一位质数","NextMtn":"换装:洞悉"},{"Text":"快乐的捕鸟人","NextMtn":"换装:魔笛"},{"Text":"泉眼深处","NextMtn":"换装:泉眼"},{"Text":"完美的流体","NextMtn":"换装:流体"}],"Priority":9},{"Name":"原皮","Text":"原皮","Command":"change_cos 90d8644e2a1bbecca3c845c41937b1dd.bin3","Priority":9},{"Name":"洞悉","Text":"洞悉","Command":"change_cos 1efa04e576aa5447703fe8053127c4c8.bin3","Priority":9},{"Name":"魔笛","Text":"魔笛","Command":"change_cos a30907361155f9736acdb00055ebc043.bin3","Priority":9},{"Name":"泉眼","Text":"泉眼","Command":"change_cos 68ebbe52a1db89b500a70221ab49c47d.bin3","Priority":9},{"Name":"流体","Text":"泉眼","Command":"change_model 662961567ba67e016ed9633ff2991193.bin3","Priority":9}],"Start":[{"Name":"无语音","Command":"mouse_tracking disable","VarFloats":[{"Name":"登场语音","Type":1,"Code":"equal 1"}]},{"Name":"特殊入场","File":"9882cb4577dfe68ffa0e588f0ce0e0e8.motion3.json","Sound":"446adc7aa1387bced60d2fc7bafd705c.mp3","Text":"验算的结果正如预想，不同的景色并不会改变洞穴的本质，就像投影的交替并不会改变事物本身。","FadeOut":1,"Command":"mouse_tracking disable","PostCommand":"clear_exp","MotionDuration":5400,"Priority":3,"Interruptable":true,"VarFloats":[{"Name":"登场语音","Type":1,"Code":"equal 0"}]},{"Name":"问候","File":"3fb918ffe274fdda7f8698bfbcafd8fc.motion3.json","Sound":"70676c1d004f029b7a4574b7ed6630d3.mp3","Text":"你来得正好，维尔汀！这些彩色的燕子待在房间里违反了……嗯？不是燕子？好吧，如果这两者没有交集的话……","FadeOut":1,"Expression":"e_kaixin.exp3","Command":"mouse_tracking disable","PostCommand":"clear_exp","MotionDuration":2800,"Priority":3,"Interruptable":true,"NextMtn":"1:idle 2","VarFloats":[{"Name":"登场语音","Type":1,"Code":"equal 0"}]},{"Name":"朝晨","File":"484769ee379f1775acd5237fb9a698eb.motion3.json","Sound":"ad76fab6ee78b9eb5b94d6f46c3d0647.mp3","Text":"你是说咖啡豆虽然长得像豆子，但并不是豆科的子集？……不，在我验证过这个假说之前，我不会接受咖啡的。","FadeOut":1,"Expression":"e_chijing.exp3","Command":"mouse_tracking disable","PostCommand":"clear_exp","MotionDuration":5600,"Priority":4,"Interruptable":true,"TimeLimit":{"Hour":7,"Sustain":240},"NextMtn":"1:摇头","VarFloats":[{"Name":"登场语音","Type":1,"Code":"equal 0"}]},{"Name":"信任-朝晨","File":"d3367c209b2490f0a04a9860dfa9a05b.motion3.json","Sound":"a45797ffec8f3657744ca4ed94ad19e7.mp3","Text":"我观察了你近期醒来后仍待在床上的时间，它们正在无限趋近于零！很快你就会有足够的晨间空闲来学习收拾床褥了。","FadeOut":1,"Expression":"e_kaixin.exp3","Command":"mouse_tracking disable","PostCommand":"clear_exp","MotionDuration":5800,"Priority":4,"Interruptable":true,"TimeLimit":{"Hour":7,"Sustain":240},"NextMtn":"1:idle 4","VarFloats":[{"Name":"登场语音","Type":1,"Code":"equal 0"}]},{"Name":"夜暮","File":"3fb918ffe274fdda7f8698bfbcafd8fc.motion3.json","Sound":"fde31f9358d6d6868faeb59dbb0b127b.mp3","Text":"每个洞穴都有着一定相似性。虽然水流拍打声并不相同，但都有其规律，这可以用来验证毕氏音程的合理性。","FadeOut":1,"Expression":"e_idle.exp3","Command":"mouse_tracking disable","PostCommand":"clear_exp","MotionDuration":2800,"Priority":4,"Interruptable":true,"TimeLimit":{"Hour":19,"Sustain":240},"NextMtn":"1:提议2","VarFloats":[{"Name":"登场语音","Type":1,"Code":"equal 0"}]},{"Name":"信任-夜暮","File":"3fb918ffe274fdda7f8698bfbcafd8fc.motion3.json","Sound":"b1cb438f60a30856ea41c118f77968db.mp3","Text":"我在考虑给我的房间加一扇小门，这样你就不管多晚都可以来访了。","FadeOut":1,"Expression":"e_idle.exp3","Command":"mouse_tracking disable","PostCommand":"clear_exp","MotionDuration":2800,"Priority":4,"Interruptable":true,"TimeLimit":{"Hour":19,"Sustain":240},"NextMtn":"1:心虚","VarFloats":[{"Name":"登场语音","Type":1,"Code":"equal 0"}]}],"Tap":[{"Name":"初遇","File":"44decc2a659fd1d3b7c7d8f9af60838c.motion3.json","Sound":"89274e158e1fbbe764ccbf389cc05e05.mp3","Text":"一个全新的洞穴！还有这些似曾相识的角度与曲线，我可以在这儿进行一些推论的验算！","FadeOut":1,"Expression":"e_kaixin.exp3","Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":3800,"Priority":4,"Interruptable":true,"NextMtn":"1:伸手"},{"Name":"箱中气候","File":"3fb918ffe274fdda7f8698bfbcafd8fc.motion3.json","Sound":"b19d45764629baae7637168ad906d54c.mp3","Text":"这里的天光和岛上的很相似，它好像能透过我的颅骨与思维，将答案映射在水面上……","FadeOut":1,"Expression":"e_chijing.exp3","Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":3200,"Priority":4,"Interruptable":true,"NextMtn":"1:提议"},{"Name":"致未来","File":"d3367c209b2490f0a04a9860dfa9a05b.motion3.json","Sound":"40f7bffa2bb6d6a9e15f2b51d80e207a.mp3","Text":"也许过大的目标会导致逻辑上的越界，所以我们需要把目标放小，比起回归纯粹的数式，我们应该先求出能导向十年后的式子……又或者一年后？","FadeOut":1,"Expression":"e_shengqi.exp3","Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":6200,"Priority":4,"Interruptable":true,"NextMtn":"1:思索1"},{"Name":"孑立","File":"484769ee379f1775acd5237fb9a698eb.motion3.json","Sound":"7ba0e09bab02d3d5ccf3982198f96b19.mp3","Text":"你在尝试进入静止状态么？那是不可能的，比如对于那些下落的雨滴来说，你和整个世界都在不断上升。","FadeOut":1,"Expression":"e_chijing.exp3","Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":6200,"Priority":4,"Interruptable":true,"NextMtn":"1:idle 1"}],"1-3":[{"Name":"帽檐与发鬓","File":"e2320e0302876c8b42da243297b4a044.motion3.json","Sound":"f08588213ea6f34a9961a614ab8d6c15.mp3","Text":"我发现很多鸟儿都喜欢这里，特别是那些彩色鸟儿，也许我可以像你一样戴一顶帽子供它们休息。","FadeOut":2,"Expression":"e_chijing.exp3","Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":6200,"Priority":4,"Interruptable":true,"NextMtn":"1:idle 4"},{"Name":"袖与手","File":"d3367c209b2490f0a04a9860dfa9a05b.motion3.json","Sound":"3ad83592b95ed46153e056b8828ae5dd.mp3","Text":"听我说，维尔汀，世界各地似乎有不同的握手礼仪。也许……我们可以做一次交叉验证的尝试？","FadeOut":1,"Expression":"e_chijing.exp3","Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":5800,"Priority":4,"Interruptable":true,"NextMtn":"1:思索"},{"Name":"衣着与身形","File":"bfe55baa111af938325312864c5d97e3.motion3.json","Sound":"bf8dd2790844c2e408274d391509dfa8.mp3","Text":"几何有时是数字的居所，而几何又栖居在我的衣服上……嗯，所以数字也可以是几何的居所。","FadeOut":1,"Expression":"e_shishen.exp3","Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":5600,"Priority":4,"Interruptable":true,"NextMtn":"1:思索"}],"2-3":[{"Name":"嗜好","File":"d3367c209b2490f0a04a9860dfa9a05b.motion3.json","Sound":"1fcb1f901af7225164aa5582c2fd3052.mp3","Text":"我现在是否有了可以轻易放弃的、短暂的，但是又喜爱的东西？也许冰淇淋？但我不确定我是否会放弃它……","FadeOut":1,"Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":5800,"Priority":4,"Interruptable":true,"NextMtn":"1:思索3"},{"Name":"赞赏","File":"2d2b2cfe24625d91db1897d5470539b3.motion3.json","Sound":"709c94fac54fe2d771ee4f5ceb15aa17.mp3","Text":"虽然推论过程有些不同，但我们都在试着驱散笼罩现象世界的迷雾，我很期待你提出的论点，维尔汀。","FadeOut":1,"Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":2400,"Priority":4,"Interruptable":true,"NextMtn":"1:提议3"},{"Name":"亲昵","File":"fdf59cdfb7b14bb80462c12f3a8300b7.motion3.json","Sound":"478dac690f9c3b5e7598f747380c03c0.mp3","Text":"如果你有解不开的问题，就来找我，维尔汀。一个人思考很容易陷入逻辑的漩涡。","FadeOut":1,"Command":"clear_exp","PostCommand":"clear_exp","MotionDuration":5400,"Priority":4,"Interruptable":true,"NextMtn":"1:摇头1"}],"3-3":[{"Name":"闲谈1","File":"d3367c209b2490f0a04a9860dfa9a05b.motion3.json","Sound":"07897d9da3325673439f81802bd8eff3.mp3","Text":"我见过了你说的那位用十六进制交谈的小姐，还进行了一些深刻的讨论，那真是一次愉快的交谈！她确实有一个很奇妙的数字！","FadeOut":1,"Expression":"e_kaixin.exp3","PostCommand":"clear_exp","MotionDuration":6200,"Priority":4,"Interruptable":true,"NextMtn":"1:点头"},{"Name":"闲谈2","File":"b116a05aaa6b7dc2891abcb9ff4f134b.motion3.json","Sound":"d778892ccd7c9fdf4dd11aaa18f74456.mp3","Text":"水是连接数字和现象的一种优良介质，我们可以用水来设定温度、质量、体积，等等等等。","FadeOut":1,"Expression":"e_kaixin.exp3","PostCommand":"clear_exp","MotionDuration":7400,"Priority":4,"Interruptable":true,"NextMtn":"1:点头"},{"Name":"独白","File":"a21a5865c61f7085ef6082c9ff65d106.motion3.json","Sound":"ca5d837f3fcca009f638c806d9ed2e03.mp3","Text":"真理的紊乱只是仍未理解的规律，我们可以找出其中的真理！而如果还有漏洞，我们就继续下去，直到归纳出一个可以验证的规律！我希望等我们总结出一切规律后，苏菲亚能为我除错，就像以前那样……","FadeOut":1,"Expression":"e_idle.exp3","PostCommand":"clear_exp","MotionDuration":6800,"Priority":4,"Interruptable":true,"NextMtn":"1:提议4"}],"4-6":[{"Name":"入队","File":"3fb918ffe274fdda7f8698bfbcafd8fc.motion3.json","Sound":"fb20867487b1f8dfe871d9f5f7e15c5a.mp3","Text":"欢迎加入我的集合。\r{$br}I'm glad to count you in my set.","FadeOut":1,"Expression":"e_kaixin.exp3","PostCommand":"clear_exp","Priority":3,"Interruptable":true},{"Name":"战前","File":"d3367c209b2490f0a04a9860dfa9a05b.motion3.json","Sound":"6ec57e12806e9121adf54ac3b0881866.mp3","Text":"我恰好有一个新猜想。\r{$br}Time to verify my new hypothesis.","FadeOut":1,"Expression":"e_shengqi.exp3","PostCommand":"clear_exp","Priority":3,"Interruptable":true},{"Name":"择选咒语1","File":"6c6efbd140185958e56d921008760809.motion3.json","Sound":"d0683eef96d180800aa1338cc4496e6b.mp3","Text":"数量的关系。\r{$br}The connection between numbers.","FadeOut":1,"PostCommand":"clear_exp","Priority":3,"Interruptable":true},{"Name":"择选咒语2","File":"a21a5865c61f7085ef6082c9ff65d106.motion3.json","Sound":"3faf67609d2ee214936664b2d79e9510.mp3","Text":"空间的形式。\r{$br}Form, space, and order.","FadeOut":1,"PostCommand":"clear_exp","Priority":3,"Interruptable":true},{"Name":"择选高阶咒语","File":"484769ee379f1775acd5237fb9a698eb.motion3.json","Sound":"caa91f85f0f1c70914c8df963fcf4f06.mp3","Text":"我们有了初步结论。\r{$br}We have reached a preliminary conclusion.","FadeOut":1,"Expression":"e_kaixin.exp3","PostCommand":"clear_exp","Priority":3,"Interruptable":true},{"Name":"择选至终的仪式","File":"6c6efbd140185958e56d921008760809.motion3.json","Sound":"3467cfee11f9dac083da93cc9fb7d0d8.mp3","Text":"答案跃于水面……\r{$br}From beneath the water, the answer surfaces ...","FadeOut":1,"Expression":"e_nanguo.exp3","PostCommand":"clear_exp","Priority":3,"Interruptable":true}],"5-5":[{"Name":"释放神秘术1-1","File":"6c6efbd140185958e56d921008760809.motion3.json","Sound":"c4a9f4428a8d39af843a4784a3fdfa3c.mp3","Text":"戒律没说不可以。\r{$br}I've confirmed that this adheres to the precepts.","FadeOut":1,"Expression":"e_yansu.exp3","PostCommand":"clear_exp","Priority":3,"Interruptable":true},{"Name":"释放神秘术1-2","File":"6c6efbd140185958e56d921008760809.motion3.json","Sound":"84538cd7e31522fc4435eb764c3ad339.mp3","Text":"数字伙伴。\r{$br}Fly, my numerical friends!","FadeOut":1,"Expression":"e_kaixin.exp3","PostCommand":"clear_exp","Priority":3,"Interruptable":true},{"Name":"释放神秘术2-1","File":"3fb918ffe274fdda7f8698bfbcafd8fc.motion3.json","Sound":"746c8e7520f79294a8bfe5765621d96c.mp